# Must match the Strapi environment's REVALIDATE_SECRET.
STRAPI_URL=http://localhost:1337
REVALIDATE_SECRET=dev-secret-change-me

# Drives only the fetch-level revalidate window passed to strapiFetch. Next
# requires a statically analyzable value for each route's own `revalidate`
# export, so every route also declares `export const revalidate = 60`
# literally; changing this value alone does not change those. Falls back to
# 60 when unset or not a valid number.
REVALIDATE_WINDOW=60

# ---------------------------------------------------------------------------
# Stripe — PaymentIntents + Payment Element
# ---------------------------------------------------------------------------
# SECRET, server only. Never referenced from a "use client" file.
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# PUBLIC by design. The NEXT_PUBLIC_ prefix ships this to the browser, which is
# correct for a publishable key: it can only confirm payments the customer has
# already authorised. Never give the secret key this prefix.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional but recommended in production: a Price you manage in the dashboard.
# When unset, the app creates a Product on demand (fine for test mode only).
STRIPE_PRICE_ID=

# Base for the 3D Secure return URL.
SITE_URL=http://localhost:3000

# Subscription amount in the smallest currency unit, and its currency. The
# server reads these; a client-supplied amount is never honoured.
SUBSCRIPTION_PRICE_CENTS=800
SUBSCRIPTION_CURRENCY=usd

# NOTE: the webhook secret is NOT here. The webhook now lives in Strapi, so
# STRIPE_WEBHOOK_SECRET belongs in the repo-root .env instead.
