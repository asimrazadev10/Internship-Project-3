# Must match the Strapi environment's REVALIDATE_SECRET.
STRAPI_URL=http://localhost:1337
REVALIDATE_SECRET=dev-secret-change-me

# Drives only the fetch-level revalidate window passed to strapiFetch. Next
# requires a statically analyzable value for each route's own `revalidate`
# export, so every route also declares `export const revalidate = 60`
# literally; changing this value alone does not change those. Falls back to
# 60 when unset or not a valid number.
REVALIDATE_WINDOW=60
